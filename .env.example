# ============================================================
# CareerSaathi V2 — Environment Variables (PLACEHOLDERS ONLY)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---------- Frontend (VITE_* is bundled into the client) ----------
# Public Supabase project URL — safe for client exposure.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Public anon key — safe for client exposure (RLS enforced).
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Base URL of the Express API.
VITE_API_BASE_URL=http://localhost:4000

# ---------- Backend ----------
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
# Service role key — SERVER ONLY. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Public anon key (used for password sign-in flows).
SUPABASE_ANON_KEY=your-supabase-anon-key
CORS_ORIGIN=http://localhost:5173

# ---------- AI / DishaAI ----------
# Optional. Without a key, AI explanation endpoints return a safe
# deterministic fallback message.
OPENAI_API_KEY=
DISHAAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PYTHON_AI_SERVICE_URL=http://localhost:5000
